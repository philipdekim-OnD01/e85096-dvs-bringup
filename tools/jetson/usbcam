#!/bin/sh
# usbcam: the USB (UVC) cameras on the Jetson's screen (docs 11.113, 11.115); desktop icon usbcam.desktop (deploy.sh).
# The same viewer and options as the E850's desktop icon (features/desktop/e850-open cam, 11.114), so the two boards
# compare like with like: mpv --vo=gpu, the camera's own format. Two cameras: side by side (hstack). The window closes it.
exec 9> "${XDG_RUNTIME_DIR:-/tmp}/usbcam.lock"
flock -n 9 || { notify-send -i accessories-camera "USB 카메라" "이미 화면에 떠 있습니다." 2>/dev/null; exit 1; }
devs=
for d in /sys/class/video4linux/video*; do
    case "$(cat "$d/name")" in vi-output*) continue;; esac     # the DVS (nrv_dvs on the VI), not a USB camera
    [ "$(cat "$d/index")" = 0 ] && devs="$devs /dev/${d##*/}"   # index 1 is each camera's metadata node
done
set -- $devs
[ $# -gt 0 ] || { notify-send -i accessories-camera "USB 카메라" "연결된 USB 카메라가 없습니다. USB-A 포트에 꽂아 주세요." 2>/dev/null; exit 1; }
command -v mpv >/dev/null || { notify-send -i accessories-camera "USB 카메라" "mpv가 없습니다: sudo apt install mpv" 2>/dev/null; exit 1; }
[ $# = 1 ] && exec mpv --vo=gpu --profile=low-latency --untimed --no-terminal --title="USB 카메라" "av://v4l2:$1"
exec mpv --vo=gpu --profile=low-latency --untimed --no-terminal --title="USB 카메라" "av://v4l2:$1" --external-file="av://v4l2:$2" \
    --lavfi-complex='[vid1][vid2]hstack[vo]'
