@@ -430,6 +495,16 @@ pan_ioctl_submit(int fd, unsigned long request, void *arg)
    else
       atom.core_req = 2;
 
+   struct shim_fd *shim_fd = drm_shim_fd_lookup(fd);
+   const uint32_t *handles = (const uint32_t *)(uintptr_t) submit->bo_handles;
