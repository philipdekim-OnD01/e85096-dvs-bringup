 static int kbase_fd = -1;
+
+/* Large image BOs are CPU-cached so glReadPixels reads at cache speed instead of ~170 MB/s
+ * uncached (e850 11.82). The GPU is not IO-coherent, so the shim cleans them before every
+ * submit that lists them and invalidates them in WAIT_BO, which Mesa calls before CPU access
+ * to a BO the GPU wrote. Up to 64 MB: the 128 MB tiler heap is GPU-only but arrives without
+ * PANFROST_BO_HEAP (this branch's pan_bo.c keeps only PAN_BO_EXECUTE), and cleaning it on
+ * every submit cost ~23 ms. The cleans cost GPU-only throughput (1080p shader test 334 -> 103 fps)
+ * but make readback 10x faster, and readback is the only way to show output without KMS.
+ * PAN_KBASE_UNCACHED=1 turns caching off, PAN_KBASE_STATS=1 prints the cache maintenance time.
+ * shortcut: a CPU read that skips WAIT_BO (unsynchronized map after a fence) can see stale lines;
+ * if an app does that, run it with PAN_KBASE_UNCACHED=1 or invalidate on syncobj wait too. */
+struct kbase_bo {
+   struct shim_bo base; /* first: drm-shim frees the struct through this pointer */
+   bool cached;
+};
+
+static double sync_s[3], sync_mb[3];
+
+static void
+print_sync_stats(void)
+{
+   fprintf(stderr, "mem_sync to device %.1f MB %.1f ms, to cpu %.1f MB %.1f ms\n",
+           sync_mb[1], sync_s[1] * 1e3, sync_mb[2], sync_s[2] * 1e3);
+}
+
+static void
+kbase_bo_sync(struct shim_bo *bo, int type)
+{
+   if (!((struct kbase_bo *)bo)->cached)
+      return;
+
+   static int stats = -1;
+   if (stats < 0) {
+      stats = !!getenv("PAN_KBASE_STATS");
+      if (stats)
+         atexit(print_sync_stats);
+   }
+   struct timespec t0, t1;
+   clock_gettime(CLOCK_MONOTONIC, &t0);
+
+   struct mali_ioctl_sync s = {
+      .handle = bo->mem_addr,
+      .user_addr = (void *)(uintptr_t) bo->mem_addr,
+      .size = bo->size,
+      .type = type,
+   };
+   if (drmIoctl(kbase_fd, MALI_IOCTL_SYNC, &s) == -1)
+      perror("ioctl(mem_sync)");
+   LOG("mem_sync %d %"PRIx64" %zu\n", type, (uint64_t) bo->mem_addr, (size_t) bo->size);
+   clock_gettime(CLOCK_MONOTONIC, &t1);
+   sync_s[type] += (t1.tv_sec - t0.tv_sec) + (t1.tv_nsec - t0.tv_nsec) * 1e-9;
+   sync_mb[type] += bo->size / 1048576.0;
+}
