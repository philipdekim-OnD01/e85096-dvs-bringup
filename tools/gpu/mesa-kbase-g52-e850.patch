    struct mali_ioctl_job_submit ksubmit = {
       .nr_atoms = 1,
       .stride = sizeof(struct mali_jd_atom_v2),
@@ -469,9 +544,23 @@ pan_ioctl_submit(int fd, unsigned long request, void *arg)
    return 0;
 }
 
+/* Submits are synchronous, so the BO is idle here: only the CPU cache needs invalidating. */
+static int
+pan_ioctl_wait_bo(int fd, unsigned long request, void *arg)
+{
+   struct drm_panfrost_wait_bo *wait = arg;
+   struct shim_bo *bo = drm_shim_bo_lookup(drm_shim_fd_lookup(fd), wait->handle);
+
+   if (bo) {
+      kbase_bo_sync(bo, MALI_SYNC_TO_CPU);
+      p_atomic_dec(&bo->refcount);
+   }
+   return 0;
+}
