+/*
+ * e850 (linux510 docs 11.76): exynos_dai[] is matched to the children of the sound node by position, in
+ * the order the board overlay lists them. fdtoverlay (and so our merged.dtb) adds an overlay's new nodes in
+ * reverse order, which put SIFS2 on the UAIF0 link ("No CPU DAIs support playback for stream UAIF0").
+ * Sort the children back into the overlay's order by name; unknown names keep their DT order at the end.
+ */
+static const char * const e850_kid_order[] = {
+	"rdma", "wdma", "dual", "ddma", "uaif", "spdy", "sifs", "nsrc",
+	"rdma_be", "wdma_be", "usb", "echo", "fwd",
+};
+
+static int e850_kid_key(const char *name)
+{
+	char base[16];
+	int i, n = 0, len = 0;
 
+	while (*name && (*name < '0' || *name > '9') && len < 11)
+		base[len++] = *name++;
+	base[len] = 0;
+	while (*name >= '0' && *name <= '9')
+		n = n * 10 + (*name++ - '0');
+	if (!strcmp(name, "_be"))
+		strcat(base, "_be");
+	for (i = 0; i < ARRAY_SIZE(e850_kid_order); i++)
+		if (!strcmp(base, e850_kid_order[i]))
+			return i * 100 + n;
+	return 10000;
+}
+
+static int e850_sorted_children(struct device_node *np, struct device_node **kids, int max)
+{
+	struct device_node *child, *t;
+	int n = 0, i, j;
+
+	for_each_child_of_node(np, child)
+		if (n < max)
+			kids[n++] = of_node_get(child);
+	for (i = 1; i < n; i++)		/* insertion sort: stable */
+		for (j = i; j > 0 && e850_kid_key(kids[j - 1]->name) > e850_kid_key(kids[j]->name); j--) {
+			t = kids[j];
+			kids[j] = kids[j - 1];
+			kids[j - 1] = t;
+		}
+	return n;
+}
