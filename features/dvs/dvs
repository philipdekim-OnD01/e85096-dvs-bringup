#!/bin/sh
# dvs: the DVS (S5KRC1S on CN4) in an X window, the settings panel beside it (dvspanel) and the settings page on :8080
# (docs 11.97, 11.98). From a terminal in X:
#   dvs [ov5647-cap.py args]      q, Esc, closing the window or Ctrl+C ends it
#   dvs --auto                    the same, quietly (x-kms.sh runs it when the GPU desktop starts)
# Only with the sensor on CN4 (11.114): without it `dvs` says so in a message box (e850-say), --auto only in its log.
# Runs dvslive.sh as root (sudo asks for the password); dvslive.service is stopped meanwhile and started again after.
set -u
[ -n "${DISPLAY:-}" ] || { echo "dvs: no DISPLAY: run it from a terminal in X" >&2; exit 1; }
if [ "$(id -u)" != 0 ]; then
    exec sudo env DISPLAY="$DISPLAY" XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" CTL_PORT="${CTL_PORT:-8080}" \
        /usr/local/bin/dvs "$@"
fi
auto=
if [ "${1:-}" = --auto ]; then
    shift
    auto=1
else
    systemctl stop e850-dvs 2>/dev/null     # the window of the desktop start: this one takes over
fi
# two of them would stop each other's capture (dvslive.sh ends a running one)
exec 9> /run/dvs.lock
flock -n 9 || { echo "dvs: already running (q in its window ends it)" >&2; exit 1; }
was=$(systemctl is-active dvslive 2>/dev/null)
[ "$was" = active ] && systemctl stop dvslive
P=
trap '[ -z "$P" ] || kill $P 2>/dev/null; [ "$was" = active ] && systemctl start dvslive' EXIT
trap 'exit 130' INT TERM
ip=$(hostname -I 2>/dev/null | cut -d' ' -f1)
echo "dvs: settings page http://${ip:-<board>}:${CTL_PORT:-8080}/  (q or Esc in the window ends it)"
# the panel shows itself once the page answers, and follows the capture's restarts
if [ -x /usr/local/bin/dvspanel ]; then
    NO_AT_BRIDGE=1 /usr/local/bin/dvspanel "${CTL_PORT:-8080}" > /dev/null 2>&1 9>&- &
    P=$!
fi
# The capture also ends on purpose to start again, as under dvslive.service: a sensor setting from the page, or no
# frame for 3 s (another program opening the camera nodes stops the stream: Firefox looks for cameras when fimc-is
# comes up, 11.97). Only SIGINT (q, Esc, closing the window, Ctrl+C) makes ov5647-cap.py exit 130; 3: no sensor.
fails=0
while :; do
    DVS_X11=1 DVS_LOG=- /usr/local/bin/dvslive.sh "$@" 9>&-
    st=$?
    [ $st = 130 ] && exit 0
    if [ $st = 3 ]; then
        echo "dvs: no DVS on CN4"
        [ -n "$auto" ] || ! command -v e850-say >/dev/null || e850-say DVS "DVS 센서가 연결되어 있지 않습니다 (CN4)." 9>&-
        exit 0
    fi
    if [ $st = 0 ]; then fails=0; else fails=$((fails + 1)); fi
    [ $fails -ge 3 ] && { echo "dvs: the capture failed $fails times in a row (exit $st)" >&2; exit $st; }
    echo "dvs: capture ended (exit $st), starting again (q or Esc in the window ends it)"
    sleep 2
done
